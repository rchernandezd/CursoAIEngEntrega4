# --- Variables exigidas por la consigna ---
PINECONE_API_KEY=pcsk_tu_api_key_de_app.pinecone.io
OPENAI_API_KEY=sk-solo_necesaria_si_EMBEDDING_PROVIDER=openai
# ANTHROPIC_API_KEY=sk-ant-alternativa_a_OpenAI_para_la_etapa_de_generacion (no se usa en esta entrega)
INDEX_NAME=techcorp-rag-e5

# --- Pinecone ---
PINECONE_NAMESPACE=techcorp-dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine

# --- Embeddings y chunking ---
# huggingface (local, gratis, 384 dims) | openai (text-embedding-3-small, 1536 dims, requiere OPENAI_API_KEY
# y un INDEX_NAME propio, ej. techcorp-rag-oai-1536)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small
DATA_DIR=data
CATALOG_PATH=data/catalog.json
CHUNK_SIZE=500
CHUNK_OVERLAP=75
UPSERT_BATCH_SIZE=100

# --- Recuperación híbrida ---
TOP_K=5
CANDIDATE_K=10
# Elegidos con `python evaluate.py --sweep-pesos` (ver README → Evaluación): 0.3/0.7 maximiza MRR
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
RRF_C=60

# --- Evaluación ---
GOLDEN_SET_PATH=eval/golden_set.json
REPORTS_DIR=reports

LOG_LEVEL=INFO
HF_HUB_DISABLE_SYMLINKS_WARNING=1
TOKENIZERS_PARALLELISM=false
